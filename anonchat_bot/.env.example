# Скопируй этот файл в .env и заполни.
# api_id и api_hash берутся на https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Папка с .session-файлами (относительно папки проекта)
SESSIONS_DIR=sessions
# Необязательно: явный список сессий через запятую (имена без .session).
# Если пусто — берутся все .session из SESSIONS_DIR.
SESSIONS=

BOT_USERNAME=N1anonchat_bot

# Регулярки (регистр не важен). Подправь после --dry-run под реальные тексты бота.
SEARCH_BUTTON_REGEX=поиск|найти собеседника|искать
# Текст, который отправится сообщением, если кнопку поиска не нашли
SEARCH_FALLBACK_TEXT=Поиск собеседника
CHECK_BUTTON_REGEX=провер|подписал|продолж|готово|✅
SUCCESS_REGEX=ищем собеседника|поиск начат|ид[её]т поиск|собеседник найден|ищем для вас
FAIL_REGEX=не подписал|подпишитесь|не выполнил|не все|не на все
CAPTCHA_REGEX=капч|captcha|не робот|докажите|решите пример

# Тайминги (секунды)
REPLY_TIMEOUT=20
CHECK_DELAY=5
MAX_CHECK_ROUNDS=3
ACTION_DELAY_MIN=2
ACTION_DELAY_MAX=5
ACCOUNT_PAUSE=30
FLOOD_MAX_WAIT=120

# 1 — если спонсора (Mini App с крутилкой/Cloudflare) не удалось пройти автоматически,
# скрипт остановится, покажет какие кнопки открыть в Telegram, и после Enter нажмёт «Проверить».
# 0 — не ждать, сразу жать «Проверить».
MANUAL_WAIT=1

# 1 — открывать Mini App спонсоров в видимом окне браузера (Edge/Chrome):
# видно, что происходит, а скрипт ловит, куда страница перекидывает.
SHOW_BROWSER=1
# Сколько секунд ждать перекида на странице
BROWSER_WAIT=40

# Необязательно: один прокси для всех аккаунтов.
# Формат: socks5://user:pass@host:port  или  http://host:port
PROXY=
