DATABASE_URL=postgres://postgres:postgres@localhost:5433/telegram_casino
JWT_SECRET=dev-secret-change-me
TELEGRAM_BOT_TOKEN=test-bot-token-123456:ABCDEF
TELEGRAM_WEBHOOK_SECRET=test-webhook-secret
# Accepted as an additional valid initData signing key outside production only
# (NODE_ENV !== 'production'), so the frontend's ?mock=1 dev login never needs
# the real TELEGRAM_BOT_TOKEN embedded in client-side code. Set NODE_ENV=production
# on real deployments so this fallback is disabled.
TELEGRAM_DEV_MOCK_TOKEN=test-bot-token-123456:ABCDEF
STARS_TO_GRAM_RATE=1
DEPOSITS_ENABLED=true
PORT=3000
ADMIN_TELEGRAM_ID=123456789
GIFT_RESOLVER_PYTHON=python3
GIFT_RESOLVER_SCRIPT=services/gift-resolver/resolve_gift.py
